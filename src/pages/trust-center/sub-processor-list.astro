---
import Layout from '../../layouts/Layout.astro';
import { getDocNav } from '../../lib/docNav.js';

const allDocs = await getDocNav();
const currentHref = '/trust-center/sub-processor-list';
---

<Layout
  title="Sub-processor List — Fenn Agritech"
  description="The third parties that process Fenn customer data."
  currentPage="trust-center"
>
  <section class="doc-page">
    <div class="doc-page__inner">
      <div class="doc-nav">
        <button class="doc-nav__toggle" id="docNavToggle" aria-expanded="false">
          All documents
          <span class="doc-nav__chevron">&#9662;</span>
        </button>
        <ul class="doc-nav__list" id="docNavList">
          {allDocs.map(d => (
            <li>
              <a
                href={d.href}
                class={d.href === currentHref ? 'doc-nav__link doc-nav__link--active' : 'doc-nav__link'}
              >
                {d.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <article class="doc-body">
        <h1 class="doc-body__title">Sub-processor List</h1>
       <p class="doc-body__meta">Version 1.0 · Updated 14 May 2026</p>
        <p class="doc-body__meta doc-body__meta--github">
          <a href="https://github.com/drea-wichman/fenn/blob/main/sub-processor-list.md" target="_blank" rel="noopener" class="doc-body__github">View on GitHub →</a>
        </p>

        <p class="doc-body__intro">
          Fenn engages the following sub-processors to process customer personal data. Before engaging any sub-processor, Fenn performs a vendor security assessment and enters a written agreement that imposes data protection obligations no less protective than those in the Fenn Data Processing Agreement.
        </p>

        <p class="doc-body__intro">
          This list is incorporated by reference into the Fenn Data Processing Agreement.
        </p>

        <table class="doc-table">
          <thead>
            <tr>
              <th>Sub-processor</th>
              <th>Purpose</th>
              <th>Location</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Amazon Web Services EMEA SARL</td>
              <td>Cloud infrastructure (hosting, storage, compute, backup)</td>
              <td>United Kingdom (London)</td>
            </tr>
            <tr>
              <td>Amazon Web Services EMEA SARL (SES)</td>
              <td>Transactional email</td>
              <td>United Kingdom (London)</td>
            </tr>
            <tr>
              <td>Stripe Payments UK Ltd</td>
              <td>Payment processing</td>
              <td>United Kingdom</td>
            </tr>
            <tr>
              <td>Functional Software, Inc. (Sentry)</td>
              <td>Application error monitoring</td>
              <td>European Union (Frankfurt)</td>
            </tr>
            <tr>
              <td>Plain Systems Ltd</td>
              <td>Customer support</td>
              <td>European Union</td>
            </tr>
          </tbody>
        </table>

        <h2 class="doc-body__h2">Notification of changes</h2>
        <p class="doc-body__p">
          Fenn provides 30 days' advance notice before engaging a new sub-processor. Notifications go to the data protection contact in each customer's account.
        </p>
        <p class="doc-body__p">
          Customers may object in writing within 30 days of notification. If no objection is received, the new sub-processor is deemed accepted. If Fenn cannot accommodate a reasonable objection, the customer may terminate the affected service and receive a pro-rata refund of prepaid fees.
        </p>

        <p class="doc-body__p">
          For questions or to request additions, contact <a href="mailto:privacy@fennagritech.io" class="doc-body__link">privacy@fennagritech.io</a>.
        </p>
      </article>
    </div>
  </section>
</Layout>

<script>
  const toggle = document.getElementById('docNavToggle');
  const list = document.getElementById('docNavList');
  if (toggle && list) {
    toggle.addEventListener('click', () => {
      const open = list.classList.toggle('doc-nav__list--open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', (e) => {
      if (!toggle.contains(e.target) && !list.contains(e.target)) {
        list.classList.remove('doc-nav__list--open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

<style>
  .doc-page {
    background: var(--color-light);
    padding: 64px 0 120px;
  }
  .doc-page__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* Document nav dropdown */
  .doc-nav {
    position: relative;
    margin-bottom: 40px;
    text-align: right;
  }
  .doc-nav__toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-steel);
    border: 1px solid var(--color-steel);
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #fafaf7;
    cursor: pointer;
    transition: opacity var(--transition);
  }
  .doc-nav__toggle:hover {
    opacity: 0.7;
  }
  .doc-nav__chevron {
    font-size: 10px;
  }
  .doc-nav__list {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 8px;
    background: var(--color-light);
    border: 1px solid rgba(13, 32, 24, 0.15);
    border-radius: 8px;
    padding: 12px 0;
    list-style: none;
    min-width: 280px;
    box-shadow: 0 8px 24px rgba(13, 32, 24, 0.12);
    z-index: 10;
  }
  .doc-nav__list--open {
    display: block;
  }
  .doc-nav__list li {
    margin: 0;
  }
  .doc-nav__link {
    display: block;
    padding: 8px 20px;
    font-size: 14px;
    color: var(--color-ink);
    text-decoration: none;
    transition: background var(--transition);
  }
  .doc-nav__link:hover {
    background: rgba(13, 32, 24, 0.04);
  }
  .doc-nav__link--active {
    font-weight: 600;
  }

  /* Document body */
  .doc-body {
    min-width: 0;
  }
  .doc-body__title {
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--text-on-light);
    line-height: 1.15;
    margin-bottom: 12px;
  }
.doc-body__meta {
    font-size: 13px;
    color: var(--text-muted-on-light);
    margin-bottom: 4px;
  }
  .doc-body__meta--github {
    margin-bottom: 32px;
  }
  .doc-body__github {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--color-steel);
    text-decoration: none;
    transition: text-decoration-color var(--transition);
  }
  .doc-body__github:hover {
    text-decoration: underline;
  }
  .doc-body__intro {
    font-size: 15px;
    color: var(--text-on-light);
    line-height: 1.7;
    margin-bottom: 16px;
  }
  .doc-body__h2 {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-on-light);
    letter-spacing: -0.3px;
    margin-top: 40px;
    margin-bottom: 12px;
  }
  .doc-body__p {
    font-size: 15px;
    color: var(--text-on-light);
    line-height: 1.7;
    margin-bottom: 12px;
  }
  .doc-body__link {
    color: var(--color-steel);
    text-decoration: none;
  }
  .doc-body__link:hover {
    text-decoration: underline;
  }

  /* Table */
  .doc-table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0 32px;
    font-size: 14px;
  }
  .doc-table th {
    text-align: left;
    padding: 12px 16px;
    background: rgba(13, 32, 24, 0.05);
    color: var(--text-on-light);
    font-weight: 700;
    border-bottom: 1px solid rgba(13, 32, 24, 0.12);
  }
  .doc-table td {
    padding: 14px 16px;
    color: var(--text-on-light);
    border-bottom: 1px solid rgba(13, 32, 24, 0.08);
    line-height: 1.5;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .doc-body__title {
      font-size: 28px;
    }
    .doc-table {
      font-size: 13px;
    }
    .doc-table th,
    .doc-table td {
      padding: 10px 12px;
    }
  }
</style>