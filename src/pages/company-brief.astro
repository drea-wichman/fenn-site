---
import Layout from '../layouts/Layout.astro';
import { Content } from './_company-brief.md';
---

<Layout
  title="Company Brief — Fenn Agritech"
  description="The fictional company profile behind Fenn's portfolio documents."
  currentPage="building-fenn"
>
  <section class="legal">
    <div class="legal__inner">
      <p class="legal__label">Company</p>
      <h1 class="legal__title">Company Brief</h1>

      <div class="brief">
        <Content />
      </div>

      <p class="legal__p legal__p--links">For the story behind Fenn, see <a href="/building-fenn" class="legal__link">Building Fenn →</a>. For the full decision trail, see the <a href="https://github.com/drea-wichman/fenn/blob/main/build-log.md" target="_blank" rel="noopener" class="legal__link">Build Log →</a>.</p>
    </div>
  </section>
</Layout>

<style>
  .legal {
    background: var(--color-light);
    padding: 80px 0 120px;
  }
  .legal__inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .legal__label {
    color: var(--color-steel);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .legal__title {
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -1.5px;
    color: var(--text-on-light);
    line-height: 1.1;
    margin-bottom: 40px;
  }
  .brief :global(h2) {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-on-light);
    letter-spacing: -0.3px;
    margin-top: 40px;
    margin-bottom: 12px;
  }
  .brief :global(p),
  .legal__p {
    font-size: 15px;
    color: var(--text-on-light);
    line-height: 1.7;
    margin-bottom: 12px;
  }
  .brief :global(strong) {
    color: var(--text-on-light);
    font-weight: 700;
  }
  .brief :global(a),
  .legal__link {
    color: var(--color-steel);
  }
  .brief :global(a:hover),
  .legal__link:hover {
    text-decoration: underline;
  }
  .legal__p--links {
    margin-top: 40px;
  }

  @media (max-width: 768px) {
    .legal__title { font-size: 32px; }
    .legal { padding: 48px 0 80px; }
  }
</style>
