<!-- Welcome modal (shows on first visit) -->
<div class="modal-backdrop" id="welcome-modal" role="dialog" aria-modal="true" aria-label="Welcome">
  <div class="modal">
    <p class="modal__body">
      Fenn is a fictional company built as an independent GRC portfolio project. Vendor names on this site are real, but no affiliation or endorsement is implied.
    </p>

    <button class="modal__btn" id="dismiss-welcome">I understand</button>
  </div>
</div>

<!-- Contact modal (opens when Contact us is clicked) -->
<div class="modal-backdrop" id="contact-modal" role="dialog" aria-modal="true" aria-labelledby="contact-title">
  <div class="modal">
    <button class="modal__close" id="close-contact" aria-label="Close">&times;</button>

    <div class="modal__top">
      <h2 class="modal__title" id="contact-title">Fenn is fictional, but the work is real.</h2>

      <div class="modal__buttons">
        <a href="mailto:hello@wichman.io" class="modal__link"><svg class="modal__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg><span class="modal__dest"><span class="sr-only">Email: </span>hello@wichman.io</span></a>
        <a href="https://linkedin.com/in/drea-wichman" target="_blank" rel="noopener" class="modal__link"><svg class="modal__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" /></svg><span class="modal__dest"><span class="sr-only">LinkedIn: </span>linkedin.com/in/drea-wichman</span></a>
        <a href="https://github.com/drea-wichman" target="_blank" rel="noopener" class="modal__link"><svg class="modal__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg><span class="modal__dest"><span class="sr-only">GitHub: </span>github.com/drea-wichman</span></a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Dark glass windows over a lightly blurred page. */
  .modal-backdrop {
    display: none !important;
    position: fixed;
    inset: 0;
    background: rgba(26, 34, 24, 0.45);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .modal-backdrop.is-open {
    display: flex !important;
  }

  .modal {
    position: relative;
    width: 100%;
    max-width: 460px;
    padding: 40px 40px 32px;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: rgba(26, 34, 24, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(240, 235, 216, 0.14);
    border-radius: 6px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }

  .modal__title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-paper);
    margin: 0 0 24px;
    padding-right: 24px;
  }

  .modal__body {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-vellum);
    line-height: 1.55;
    margin: 0 0 28px;
  }

  .modal__btn {
    align-self: flex-start;
    padding: 10px 24px;
    background: transparent;
    color: var(--color-paper);
    border: 1px solid var(--color-paper);
    border-radius: 6px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.005em;
    cursor: pointer;
    transition: background var(--transition), color var(--transition);
  }

  .modal__btn:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .modal__buttons {
    display: flex;
    flex-direction: column;
  }

  .modal__link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 0;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 400;
    color: var(--color-vellum);
    text-decoration: none;
    transition: color var(--transition);
  }

  /* Hover: icon and address turn light blue, like the nav links. */
  .modal__link:hover {
    color: var(--color-steel-light);
  }

  .modal__icon {
    flex: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Contact: title fits on one line on desktop. */
  #contact-modal .modal {
    max-width: 540px;
  }

  #contact-modal .modal__title {
    font-size: 22px;
    white-space: nowrap;
  }

  .modal__close {
    position: absolute;
    top: 20px;
    right: 20px;
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1;
    color: var(--color-paper);
    background: transparent;
    border: none;
    padding: 4px 8px;
    cursor: pointer;
    transition: color var(--transition);
  }

  .modal__close:hover {
    color: var(--color-steel-light);
  }

  /* Welcome notice is centered. */
  #welcome-modal .modal {
    text-align: center;
    align-items: center;
  }

  #welcome-modal .modal__btn {
    align-self: center;
  }

  @media (max-width: 480px) {
    .modal {
      padding: 32px 24px 24px;
    }

    #contact-modal .modal__title {
      white-space: normal;
    }

    .modal__link {
      font-size: 14px;
    }
  }
</style>

<script>
  function initModals() {
    const welcomeModal = document.getElementById('welcome-modal');
    const dismissWelcome = document.getElementById('dismiss-welcome');
    const openWelcomeBtn = document.getElementById('open-welcome-modal');

    // First-visit auto-open. Guarded so a missing element or thrown
    // localStorage access (e.g. third-party-cookie-blocked Safari) doesn't
    // kill the rest of the script.
    try {
      if (welcomeModal && !localStorage.getItem('fenn-welcome-seen-v4')) {
        welcomeModal.classList.add('is-open');
      }
    } catch (_) {
      if (welcomeModal) welcomeModal.classList.add('is-open');
    }

    dismissWelcome?.addEventListener('click', () => {
      welcomeModal?.classList.remove('is-open');
      try { localStorage.setItem('fenn-welcome-seen-v4', 'true'); } catch (_) {}
    });

    openWelcomeBtn?.addEventListener('click', () => {
      welcomeModal?.classList.add('is-open');
    });

    const contactModal = document.getElementById('contact-modal');
    const openContactBtn = document.getElementById('open-contact-modal');
    const closeContactBtn = document.getElementById('close-contact');

    openContactBtn?.addEventListener('click', () => {
      contactModal?.classList.add('is-open');
    });

    closeContactBtn?.addEventListener('click', () => {
      contactModal?.classList.remove('is-open');
    });

    contactModal?.addEventListener('click', (e) => {
      if (e.target === contactModal) {
        contactModal.classList.remove('is-open');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        contactModal?.classList.remove('is-open');
        welcomeModal?.classList.remove('is-open');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModals);
  } else {
    initModals();
  }
</script>
