---
const { currentPage = '' } = Astro.props;
---

<header class="header">
  <div class="header__inner">
    {currentPage === 'tally' ? (
      <span class="header__logo-spacer" aria-hidden="true"></span>
    ) : (
      <a href="/" class="header__logo">
        <img src="/logo-final.png" alt="Fenn" width="1009" height="292" />
      </a>
    )}

    <nav class="header__nav">
      <a href="/trust-center" class={currentPage === 'trust-center' ? 'header__link header__link--active' : 'header__link'}>Trust Center</a>
      <a href="/behind-fenn" class={currentPage === 'behind-fenn' ? 'header__link header__link--active' : 'header__link'}>Behind Fenn</a>
      {currentPage === 'tally' ? (
        <a href="/" class="header__link">Home</a>
      ) : (
        <a href="/tally" class="header__link">Tally</a>
      )}
      <button class="btn-outline-white header__cta" id="open-contact-modal">Contact Us</button>
    </nav>
  </div>
</header>

<style>
  .header {
    background: var(--color-ink);
    padding: 16px 0;
  }

  .header__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__logo {
    display: block;
    transition: opacity var(--transition);
    /* Align with hero headline left edge: clamps to 0 below 1280vw, -40 above 1360vw. */
    margin-left: min(0px, max(-40px, calc(640px - 50vw)));
  }

  .header__logo:hover {
    opacity: 0.85;
  }

  .header__logo img {
    display: block;
    height: 72px;
    width: auto;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .header__link {
    font-family: var(--font-display);
    color: var(--color-paper);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.005em;
    text-transform: none;
    transition: color var(--transition);
  }

  .header__link:hover {
    color: var(--color-steel-light);
  }

  .header__link--active {
    color: var(--color-steel-light);
    font-weight: 600;
  }

  .header__cta {
    cursor: pointer;
    background: transparent;
    color: var(--color-paper);
    border: 1px solid var(--color-paper);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.005em;
    text-transform: none;
    padding: 7px 17px;
    transition: background 200ms ease, color 200ms ease;
  }

  .header__cta:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  /* Homepage and Tally: nav sits on the page background. */
  :global(.page-landing) .header,
  :global(.page-tally) .header {
    position: absolute;
    top: var(--banner-h, 34px);
    left: 0;
    right: 0;
    z-index: 5;
    background: transparent;
  }

  :global(.page-landing) .header__logo,
  :global(.page-tally) .header__logo {
    margin-left: 0;
  }

  :global(.page-landing) .header__logo img,
  :global(.page-tally) .header__logo img {
    height: 50px;
  }

  /* Tally page: no logo in the header (the Tally lockup carries the brand),
     and the Tally slot in the nav becomes Home. */
  .header__logo-spacer {
    display: block;
    height: 50px;
  }

  @media (max-width: 768px) {
    .header__logo img {
      height: 48px;
    }

    :global(.page-landing) .header__logo img,
    :global(.page-tally) .header__logo img {
      height: 40px;
    }

    .header__nav {
      gap: 16px;
    }

    .header__link {
      font-size: 10px;
    }
  }
</style>
