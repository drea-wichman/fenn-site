<div class="banner">
  <div class="banner__inner">
    <p>Fenn Agritech is a fictional company built for a GRC portfolio. <a class="banner__link" href="/building-fenn">See how it was built →</a></p>
  </div>
</div>

<style>
  .banner {
    background: #0A0A0A;
    color: var(--color-paper);
    padding: 8px 0;
    text-align: center;
  }

  .banner__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .banner p {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--color-paper);
  }

  .banner__link {
    color: var(--color-steel-light);
    font-weight: 500;
    text-decoration: none;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    cursor: pointer;
    padding: 0;
    transition: text-decoration-color var(--transition);
  }

  .banner__link:hover {
    text-decoration: underline;
  }

  /* Homepage and Tally: the banner is dark glass over the page. */
  :global(.page-landing) .banner,
  :global(.page-tally) .banner {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 6;
    background: rgba(26, 34, 24, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  /* Tally: lighter frosted glass. The flat ombre has nothing to show
     through dark glass, so this lets the blue and the line come through. */
  :global(.page-tally) .banner {
    background: linear-gradient(180deg, rgba(240, 235, 216, 0.16), rgba(240, 235, 216, 0.06));
    backdrop-filter: blur(14px) saturate(150%);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
    border-bottom: 1px solid rgba(240, 235, 216, 0.22);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 8px 24px rgba(10, 25, 32, 0.18);
  }

  :global(.page-landing) .banner__link,
  :global(.page-tally) .banner__link {
    color: var(--color-paper);
    text-decoration: underline;
    transition: color var(--transition);
  }

  :global(.page-landing) .banner__link:hover,
  :global(.page-tally) .banner__link:hover {
    color: var(--color-steel-light);
  }
</style>

<script>
  // Lets the homepage header sit just below the banner, whatever its height.
  const banner = document.querySelector('.banner');
  if (banner) {
    const setHeight = () =>
      document.documentElement.style.setProperty('--banner-h', `${banner.offsetHeight}px`);
    setHeight();
    new ResizeObserver(setHeight).observe(banner);
  }
</script>
